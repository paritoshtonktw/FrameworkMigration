<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>

  <connectionStrings>
    <!-- Default connection to Docker SQL Server -->
    <add name="CryptoTradingDB" connectionString="Server=localhost,1433;Database=CryptoTradingDB;User Id=sa;Password=CryptoTrading!2026Secure;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
    <!-- LocalDB connection string alternative (Windows-only):
    <add name="CryptoTradingDB" connectionString="Server=(localdb)\CryptoTradingDB;Database=CryptoTradingDB;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
    -->
  </connectionStrings>

  <appSettings>
    <add key="JwtSecret" value="SuperSecretKeyForCryptoTradingPlatform2026!ChangeInProd" />
    <add key="JwtIssuer" value="CryptoTradingPlatform" />
    <add key="JwtAudience" value="CryptoTradingClient" />
    <add key="CoinGeckoBaseUrl" value="https://api.coingecko.com/api/v3/" />
    <add key="CacheDurationSeconds" value="20" />
    <!-- AWS SQS: Local Development & Testing Profile (Default) -->
    <add key="Sqs:Enabled" value="true" />
    <add key="Sqs:AwsRegion" value="us-east-1" />
    <add key="Sqs:ServiceUrl" value="http://localhost:4566" />
    <add key="Sqs:OrdersIncomingQueueUrl" value="https://sqs.us-east-1.amazonaws.com/123456789012/crypto-orders-incoming.fifo" />
    <add key="Sqs:OrdersExecutedQueueUrl" value="https://sqs.us-east-1.amazonaws.com/123456789012/crypto-orders-executed.fifo" />
    <add key="Sqs:MarketTicksQueueUrl" value="https://sqs.us-east-1.amazonaws.com/123456789012/crypto-market-ticks.fifo" />
    <add key="Sqs:WebhookSecret" value="" />
    <add key="Sqs:TickSubscriberEnabled" value="true" />

    <!--
      AWS SQS for ECS/EKS/Elastic Beanstalk (12-Factor Environment Variables):
      ===================================================================
      In AWS, set environment variables directly or via ECS Task Definition / Secrets Manager:

      - SQS_ENABLED                   = "true"
      - SQS_AWS_REGION                = "us-east-1"
      - SQS_SERVICE_URL               = "http://localhost:4566"
      - SQS_ORDERS_INCOMING_QUEUE_URL = "https://sqs.us-east-1.amazonaws.com/123456789012/crypto-orders-incoming.fifo"
      - SQS_ORDERS_EXECUTED_QUEUE_URL = "https://sqs.us-east-1.amazonaws.com/123456789012/crypto-orders-executed.fifo"
      - SQS_MARKET_TICKS_QUEUE_URL    = "https://sqs.us-east-1.amazonaws.com/123456789012/crypto-market-ticks.fifo"
      - SQS_WEBHOOK_SECRET            = "<shared-secret-token>" (validated at /api/sqs/*)
      - SQS_TICK_SUBSCRIBER_ENABLED   = "true"

      AWS SQS Queue Creation:
      aws sqs create-queue --queue-name crypto-orders-incoming.fifo --attributes FifoQueue=true,ContentBasedDeduplication=true
    -->
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Cors" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.IdentityModel.Tokens" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.6.0.0" newVersion="5.6.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.IdentityModel.Tokens.Jwt" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.6.0.0" newVersion="5.6.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.IdentityModel.Logging" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.6.0.0" newVersion="5.6.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="App_Data/Logs/app.log" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="5" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="RollingFileAppender" />
    </root>
  </log4net>
</configuration>