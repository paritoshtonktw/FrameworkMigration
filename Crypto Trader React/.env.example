# ==============================================================================
# Crypto Trader React — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Frontend development server port
PORT=3000

# Backend REST API base URL
REACT_APP_BACKEND_URL=http://localhost:5152/api

# Backend Display Label (displayed in navigation header and login screen)
REACT_APP_BACKEND_LABEL=LEGACY

# Polling interval in seconds for prices and portfolio updates (default: 20)
REACT_APP_REFRESH_INTERVAL_SECONDS=20

# Disable automatic browser launch on startup
BROWSER=none
